{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [14, 10],
  "theme": { "light": "paper", "dark": "ink" },
  "background": "background",
  "font_size": 15,
  "terminal_padding": [28, 14],
  "preview": "mods/focus-line/preview.svg",
  "children": [
    {
      "id": "focus-top",
      "type": "block",
      "size": { "px": 34 },
      "window_drag": true,
      "content": { "mod": "focus-line", "props": { "role": "top" } }
    },
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "gap": 8,
          "radius": 6,
          "border": { "width": 1, "color": "border" },
          "focus": { "width": 1, "color": "input" }
        }
      }
    },
    {
      "id": "focus-line",
      "type": "block",
      "size": { "px": 28 },
      "content": { "mod": "focus-line", "props": { "role": "line" } }
    }
  ]
}
