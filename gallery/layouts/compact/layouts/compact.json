{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 12],
  "background": "canvas",
  "font_size": 13,
  "terminal_padding": [8, 6],
  "divider": { "width": 1, "color": "border" },
  "preview": "layouts/compact.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 48 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 38 },
          "window_drag": true,
          "content": { "mod": "workspace-chrome" }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            { "id": "spaces", "type": "block", "size": { "weight": 3 }, "min": 90, "content": { "mod": "spaces" } },
            { "id": "agents", "type": "block", "size": { "weight": 2 }, "min": 90, "content": { "mod": "agents" } }
          ]
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 38 },
          "window_drag": true,
          "content": { "mod": "tabs" }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 4,
          "gap": 4,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "empty": { "mod": "new-session", "props": { "page": true } },
                "pane": {
                  "gap": 4,
                  "radius": 6,
                  "background": "background",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 320 },
              "min": 240,
              "max": 720,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 24 },
          "content": { "mod": "workspace-status" }
        }
      ]
    }
  ]
}
