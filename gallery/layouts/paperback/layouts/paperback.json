{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "paper",
  "colors": {
    "background": "#f6eedc",
    "surface": "#f6eedc",
    "canvas": "#eee4cf",
    "chrome": "#e6dac1",
    "popover": "#fbf5e8",
    "raised": "#ece1ca",
    "hover": "#2d23180c",
    "selected": "#2d231814",
    "border": "#d8c8a8",
    "input": "#c1ad88",
    "selection": "#e9d3a6",
    "accent": "#2b4f86",
    "accent_foreground": "#fbf6ec",
    "solid": "#2d2318",
    "solid_foreground": "#f8f0df",
    "foreground": "#2d2318",
    "terminal_foreground": "#382b1d",
    "muted": "#62513d",
    "dim": "#88745b",
    "cursor": "#2b4f86",
    "ring": "#62513d",
    "working": "#875c00",
    "blocked": "#ad311f",
    "done": "#256a58",
    "idle": "#88745b",
    "unknown": "#88745b",
    "ansi0": "#2d2318",
    "ansi1": "#a5351f",
    "ansi2": "#4c6e22",
    "ansi3": "#865900",
    "ansi4": "#2b5c90",
    "ansi5": "#82437c",
    "ansi6": "#276b66",
    "ansi7": "#5c4e3e",
    "ansi8": "#76654f",
    "ansi9": "#b73d24",
    "ansi10": "#4b6e23",
    "ansi11": "#8d6108",
    "ansi12": "#2c63a2",
    "ansi13": "#8f4c88",
    "ansi14": "#2a746e",
    "ansi15": "#1d160d"
  },
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "preview": "layouts/paperback.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            },
            {
              "id": "history",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 90,
              "content": {
                "mod": "history"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 97
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "empty": {
                  "mod": "new-session",
                  "props": {
                    "page": true
                  }
                },
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "server",
                      "type": "block",
                      "content": {
                        "mod": "server"
                      }
                    },
                    {
                      "id": "mailbox",
                      "type": "block",
                      "content": {
                        "mod": "mailbox"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status-bar",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "mailbox-status",
              "type": "block",
              "size": {
                "px": 170
              },
              "content": {
                "mod": "mailbox",
                "props": {
                  "part": "status"
                }
              }
            },
            {
              "id": "server-status",
              "type": "block",
              "size": {
                "px": 220
              },
              "content": {
                "mod": "server",
                "props": {
                  "part": "status"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
