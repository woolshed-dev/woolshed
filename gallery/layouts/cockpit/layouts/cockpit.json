{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "preview": "layouts/cockpit.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 264 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "window_drag": true, "content": { "mod": "workspace-chrome" } },
        { "id": "agents", "type": "block", "content": { "mod": "agents" } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "cockpit-bar",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "cockpit", "props": { "role": "bar" } }
        },
        {
          "id": "cockpit-body",
          "type": "row",
          "padding": [8, 10],
          "gap": 10,
          "children": [
            {
              "id": "stage",
              "type": "block",
              "size": { "weight": 3 },
              "min": 360,
              "background": "background",
              "border": { "width": 1, "color": "border" },
              "focus": { "border": { "width": 1, "color": "accent" } },
              "radius": 10,
              "content": { "agent": "focused" }
            },
            {
              "id": "cockpit-side",
              "type": "column",
              "size": { "weight": 2 },
              "min": 260,
              "gap": 10,
              "resizable": false,
              "children": [
                { "id": "side-empty", "type": "block", "content": { "mod": "cockpit", "props": { "role": "empty" } } }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 28 },
          "content": { "mod": "workspace-status" }
        }
      ]
    }
  ]
}
