{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [16, 12],
  "divider": { "width": 1, "color": "border" },
  "preview": "mods/mission/preview.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 280 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "window_drag": true, "content": { "mod": "workspace-chrome" } },
        { "id": "agents", "type": "block", "content": { "mod": "agents" } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "gap": 10,
      "children": [
        { "id": "mission-head", "type": "block", "size": { "px": 56 }, "window_drag": true, "content": { "mod": "mission", "props": { "role": "head" } } },
        {
          "id": "stage-row",
          "type": "row",
          "padding": [0, 10],
          "children": [
            {
              "id": "stage",
              "type": "block",
              "background": "background",
              "border": { "width": 1, "color": "border" },
              "radius": 10,
              "content": { "agent": "focused" }
            }
          ]
        },
        { "id": "mission-strip", "type": "block", "size": { "px": 32 }, "content": { "mod": "mission", "props": { "role": "strip" } } }
      ]
    }
  ]
}
