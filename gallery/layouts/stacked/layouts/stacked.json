{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [14, 13],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "preview": "layouts/stacked.svg",
  "children": [
    {
      "id": "strip",
      "type": "block",
      "size": { "px": 76 },
      "window_drag": true,
      "content": { "mod": "stacked" }
    },
    {
      "id": "work-body",
      "type": "row",
      "padding": 8,
      "children": [
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "empty": { "mod": "new-session", "props": { "page": true } },
            "pane": {
              "gap": 8,
              "radius": 10,
              "background": "background",
              "lone": true,
              "border": { "width": 1, "color": "border" },
              "focus": { "width": 1, "color": "accent" },
              "header": { "content": { "mod": "pane" }, "height": 30, "position": "top", "reveal": "always" }
            }
          }
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": { "px": 28 },
      "content": { "mod": "workspace-status" }
    }
  ]
}
