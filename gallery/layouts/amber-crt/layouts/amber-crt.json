{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "graphite",
  "colors": {
    "background": "#0d0904",
    "surface": "#0d0904",
    "canvas": "#0a0703",
    "chrome": "#060402",
    "popover": "#171007",
    "raised": "#1f160a",
    "hover": "#ffc66e0f",
    "selected": "#ffc66e1a",
    "border": "#3a2a12",
    "input": "#56411d",
    "selection": "#4b3511",
    "accent": "#ffdb9e",
    "accent_foreground": "#0d0904",
    "solid": "#ffc66e",
    "solid_foreground": "#0d0904",
    "foreground": "#ffc66e",
    "terminal_foreground": "#f2b65c",
    "muted": "#c88d40",
    "dim": "#90652a",
    "cursor": "#ffd28c",
    "ring": "#c88d40",
    "working": "#fff3a3",
    "blocked": "#ff6a4d",
    "done": "#9ad1ff",
    "idle": "#90652a",
    "unknown": "#90652a",
    "ansi0": "#2c1f0d",
    "ansi1": "#ff7a5c",
    "ansi2": "#c9d171",
    "ansi3": "#ffd47c",
    "ansi4": "#90b9e9",
    "ansi5": "#e9a1c9",
    "ansi6": "#a9d9c1",
    "ansi7": "#f2b65c",
    "ansi8": "#916a30",
    "ansi9": "#ff9b82",
    "ansi10": "#dee595",
    "ansi11": "#ffe3a2",
    "ansi12": "#b1d0f3",
    "ansi13": "#f5bdda",
    "ansi14": "#c5e9d7",
    "ansi15": "#ffe7c1"
  },
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "preview": "layouts/amber-crt.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            },
            {
              "id": "history",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 90,
              "content": {
                "mod": "history"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 97
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "empty": {
                  "mod": "new-session",
                  "props": {
                    "page": true
                  }
                },
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "server",
                      "type": "block",
                      "content": {
                        "mod": "server"
                      }
                    },
                    {
                      "id": "mailbox",
                      "type": "block",
                      "content": {
                        "mod": "mailbox"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status-bar",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "mailbox-status",
              "type": "block",
              "size": {
                "px": 170
              },
              "content": {
                "mod": "mailbox",
                "props": {
                  "part": "status"
                }
              }
            },
            {
              "id": "server-status",
              "type": "block",
              "size": {
                "px": 220
              },
              "content": {
                "mod": "server",
                "props": {
                  "part": "status"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
